# Test Database Configuration
# Used by pytest fixtures for running test suites
TEST_POSTGRES_PORT="5433"
TEST_POSTGRES_PASSWORD="your_test_postgres_password"

TEST_MYSQL_PORT="3307"
TEST_MYSQL_ROOT_PASSWORD="your_test_mysql_password"
TEST_MYSQL_DATABASE="py_auth_db"

# Test database connection string (choose one based on your setup)
# PostgreSQL example:
TEST_DATABASE_URL="postgresql+asyncpg://postgres:your_test_postgres_password@localhost:5433/postgres"
# MySQL example:
# TEST_DATABASE_URL="mysql+aiomysql://root:your_test_mysql_password@localhost:3307/py_auth_db"
# SQLite example:
# TEST_DATABASE_URL="sqlite+aiosqlite:///./test.db"

# Application Database Configuration
# Used by example applications and development
APP_POSTGRES_PORT="5432"
APP_POSTGRES_PASSWORD="your_app_postgres_password"

# Main application database connection string
DATABASE_URL="postgresql+asyncpg://postgres:your_app_postgres_password@localhost:5432/postgres"

# Google OAuth Configuration
# Register your application at https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://127.0.0.1:8000/auth/google/callback"
